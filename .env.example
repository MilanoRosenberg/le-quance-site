# Copy to .env.local and fill in. .env.local is gitignored.

# Absolute site URL, used for canonical links, sitemap, robots and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Integration selectors — leave blank until a provider is wired up.
NEXT_PUBLIC_COMMERCE_PROVIDER=
NEXT_PUBLIC_NEWSLETTER_PROVIDER=
NEXT_PUBLIC_AUTH_PROVIDER=
